+async function prewarmResidentCfopAndZb() {
+  const startedAt = performance.now();
+  try {
+    const [{ getDefaultPattern }, cfopModule] = await Promise.all([
+      import("./context.js"),
+      import("./cfop3x3.js"),
+    ]);
+    const {
+      prewarm3x3StrictCfopLibraries,
+      solve3x3StrictCfopFromPattern,
+    } = cfopModule;
